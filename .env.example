# ConnectWise API Credentials (required)
CW_COMPANY_ID=your_company_id_here
CW_PUBLIC_KEY=your_public_key_here
CW_PRIVATE_KEY=your_private_key_here

# ConnectWise API Configuration
CW_API_URL=https://api-na.myconnectwise.net
CW_API_VERSION=v2023.2
CW_CLIENT_ID=mcp-connectwise-server

# Transport. 'stdio' for MCP clients such as Claude Code and Claude Desktop;
# 'http' to serve OpenWebUI. docker-compose sets http for you.
MCP_TRANSPORT=stdio

# Port for the http transport (ignored on stdio)
MCP_PORT=3002

# REQUIRED for the http transport -- the server refuses to start without it.
# Callers send it as:  Authorization: Bearer <token>
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Not needed on stdio, where the trust boundary is the process.
MCP_AUTH_TOKEN=

# Retries on 429 and 5xx from ConnectWise. Retry-After is honoured when sent.
CW_MAX_RETRIES=3
CW_RETRY_BASE_DELAY=0.5

# Ceiling on fetchAll, so "every ticket" cannot become fifty thousand records
CW_MAX_RECORDS=1000

# --- Writes -----------------------------------------------------------------
# EMPTY MEANS READ-ONLY, and read-only is the default. Write tools are not even
# registered unless a category is named here, so a model cannot see one to try.
#
# Comma-separated categories, or 'all':
#   notes    add notes to tickets and companies   (lowest risk)
#   time     log time entries against tickets
#   tickets  create tickets, and change any field on one   (highest risk)
#
# 'true' is NOT a valid value -- it enables nothing and logs a warning.
#
# The API member needs write rights in ConnectWise for any of this to work.
# Using a separate member from your read-only one makes the audit trail in
# ConnectWise tell you which changes came from here.
CW_ENABLE_WRITES=

# Log writes and return what WOULD have been sent, without sending it. Worth
# leaving on for the first day of any write category.
CW_WRITE_DRY_RUN=false

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
